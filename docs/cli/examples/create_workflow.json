        "fieldPermissions": [
          {
            "fieldKey": "shipping_no",
            "required": true
          },
          {
            "fieldKey": "shipping_time",
            "required": true
          }
        ],
        "approvalVisibleFieldKeys": [
          "order_no",
          "customer_name",
          "shipping_no",
          "shipping_time"
        ],
        "position": {
          "x": 640,
          "y": 180
        }
      },
      {
        "id": "end",
        "name": "结束",
        "type": "end",
        "position": {
          "x": 920,
          "y": 180
        }
      }
    ],
    "edges": [
