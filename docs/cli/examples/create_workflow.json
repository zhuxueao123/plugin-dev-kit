{
  "code": "order_approval",
  "name": "订单审批流程",
  "businessObjectType": "order",
  "description": "销售提交后，主管审批，再由仓库确认发货。",
  "metadata": {
    "authorization": {
      "startPermissionCode": "sales_order.workflow.start",
      "visiblePrincipals": [
        "initiator",
        "active_assignee",
        "active_candidate_role_member",
        "history_actor",
        "cc_user",
        "workflow_instance_admin"
      ]
    }
  },
  "draftDefinition": {
    "startNodeId": "start",
    "nodes": [
      {
        "id": "start",
        "name": "开始",
        "type": "start",
        "position": {
          "x": 120,
          "y": 180
        }
      },
      {
        "id": "manager_approve",
        "name": "主管审批",
        "type": "approval",
        "participant": {
          "type": "role",
          "roleCode": "sales_manager"
        },
        "actions": [
          {
            "code": "approve",
            "label": "同意",
            "nextNodeId": "warehouse_confirm",
            "completeProcess": false
          },
          {
