        "sourceId": "start",
        "targetId": "manager_approve",
        "order": 0
      },
      {
        "id": "edge-manager-warehouse",
        "sourceId": "manager_approve",
        "targetId": "warehouse_confirm",
        "actionCode": "approve",
        "order": 0
      },
      {
        "id": "edge-warehouse-end",
        "sourceId": "warehouse_confirm",
        "targetId": "end",
        "actionCode": "confirm_ship",
        "order": 0
      }
    ]
  }
