            "label": "驳回",
            "nextNodeId": "end",
            "completeProcess": true
          }
        ],
        "fieldPermissions": [
          {
            "fieldKey": "amount",
            "readonly": true
          },
          {
            "fieldKey": "manager_comment",
            "required": true
          }
        ],
        "approvalVisibleFieldKeys": [
          "order_no",
          "customer_name",
          "amount",
          "manager_comment"
        ],
        "position": {
          "x": 360,
          "y": 180
        }
      },
      {
        "id": "warehouse_confirm",
        "name": "仓库确认",
        "type": "task",
        "participant": {
          "type": "role",
          "roleCode": "warehouse_operator"
        },
        "actions": [
          {
            "code": "confirm_ship",
            "label": "确认发货",
            "nextNodeId": "end",
            "completeProcess": false
          }
