# Local credentials and machine-specific configuration
**/config.json
**/.env
**/.env.*

# Dependency caches generated while validating or building plugins
**/node_modules/
**/__pycache__/
**/.venv/
**/target/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.cache/
**/.vite/

# CLI-generated build, packaging, and migration directories
**/dist/
**/.generated/
**/exports/
**/tmp/
**/temp/

# Test and coverage output produced by plugin validation workflows
**/htmlcov/
**/coverage/

# Editor and operating-system files
.DS_Store
._*
Thumbs.db
*.pyc
*.pyo

# Prebuilt executables are published by GitHub Actions.
# Existing tracked deliveries stay tracked so git pull includes them.
/bin/*/asapflow/asapflow
/bin/*/asapflow/asapflow.exe
/optional/migration/legacy-export/bin/*/legacy-export
/optional/migration/legacy-export/bin/*/legacy-export.exe
